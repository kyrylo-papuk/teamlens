ANTHROPIC_API_KEY=
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=PAY
# Reach Jira through the mcp-atlassian server instead of its REST API: the command that starts the server
# ("uvx mcp-atlassian"), or the URL of a running one. docker-compose.jira.yml sets this up by itself.
TEAMLENS_JIRA_MCP=
# Optional: traces go to Langfuse when both keys are set. Names are replaced by employee ids first.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
